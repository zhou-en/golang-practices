# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Compiled program binaries (go build output has no extension)
hello-world/main
printFile/main
cards/mycards
# `go build` inside a problem folder names the binary after the folder
/p[0-9][0-9][0-9][0-9]_*/p[0-9][0-9][0-9][0-9]_*
